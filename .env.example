# 环境文件由调用者显式加载，例如 node --env-file=.env dist/cli/main.js tools。
# 本地开发配置；没有 RPC 时仍可使用 content 工具和本地 Schema 编码。
BCA_WORKING_ROOT=.
BCA_MAX_FILE_BYTES=16777216
BCA_MAX_READ_BYTES=1048576
BCA_TIMEOUT_MS=30000
BCA_ALLOW_WRITES=false

# 按实际网络明确填写；没有隐式网络或合约地址。
# BCA_RPC_URL=http://127.0.0.1:8545
# BCA_CHAIN_ID=31337
# BCA_EAS_ADDRESS=
# BCA_SCHEMA_REGISTRY_ADDRESS=

# 仅允许本地开发使用；工具输入不接收私钥。
# BCA_PRIVATE_KEY=

# 只连接操作者指定的 Kubo RPC API。
# BCA_IPFS_URL=http://127.0.0.1:5001

# 操作者配置的外部 MCP 服务（标准 mcpServers JSON）。二选一，不要把 Token 写进工具输入。
# BCA_MCP_CONFIG=.mcp-servers.json
# BCA_MCP_SERVERS={"mcpServers":{"coingecko":{"preset":"coingecko"}}}
