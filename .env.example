# 环境文件由调用者显式加载，例如 node --env-file=.env dist/cli/main.js tools。
# 本地开发配置；没有 RPC 时仍可使用 content 工具和本地 Schema 编码。
BCA_WORKING_ROOT=.
BCA_MAX_FILE_BYTES=16777216
BCA_MAX_READ_BYTES=1048576
BCA_TIMEOUT_MS=30000
BCA_ALLOW_WRITES=false
# 仅当本机 IPv4/IPv6 双栈异常、RPC 连接报 EADDRINUSE 时启用；正常环境保持 false。
# BCA_IPV4_ONLY=false

# 按实际网络明确填写；没有隐式网络或合约地址。
# BCA_RPC_URL=http://127.0.0.1:8545
# BCA_CHAIN_ID=31337
# BCA_EAS_ADDRESS=
# BCA_SCHEMA_REGISTRY_ADDRESS=

# 仅允许本地开发使用；工具输入不接收私钥。
# BCA_PRIVATE_KEY=

# 只连接操作者指定的 Kubo RPC API。
# BCA_IPFS_URL=http://127.0.0.1:5001

# 操作者配置的外部 MCP 服务（标准 mcpServers JSON）。二选一，不要把 Token 写进工具输入。
# BCA_MCP_CONFIG=.mcp-servers.json
# BCA_MCP_SERVERS={"mcpServers":{"coingecko":{"preset":"coingecko"}}}

# 多链：填写实际节点；Sui 使用 gRPC base URL，Aptos 包含 /v1。
# BCA_SUI_RPC_URL=https://fullnode.testnet.sui.io:443
# BCA_SUI_NETWORK=testnet
# BCA_APTOS_RPC_URL=https://api.testnet.aptoslabs.com/v1
# BCA_SOLANA_RPC_URL=https://api.devnet.solana.com
# BCA_SIGN_CHAIN=baseSepolia
# BCA_CHEQD_RPC_URL=

# 存储与 Seal：从官方部署文档选择与网络匹配的服务/对象。
# BCA_WALRUS_AGGREGATOR=
# BCA_WALRUS_PUBLISHER=
# BCA_SEAL_SERVERS=[{"objectId":"0x<64 hex chars>","weight":1}]
# BCA_ARWEAVE_URL=https://arweave.net

# 钱包/支付/Agent：工厂是操作者管理的本地代码，位于工作根目录内。
# 本地/私有链的官方 Safe 合约部署；按 chain ID 提供 Protocol Kit 的地址配置。
# BCA_SAFE_CONTRACT_NETWORKS={"31337":{"multiSendAddress":"0x<40 hex chars>","multiSendCallOnlyAddress":"0x<40 hex chars>"}}
# BCA_X402_FACILITATOR=
# BCA_AGENTKIT_MODULE=examples/agents/agentkit.mjs
# BCA_SOLANA_AGENT_MODULE=examples/agents/solana-agent-kit.mjs
# BCA_SOLANA_SECRET_KEY= # 示例工厂使用 JSON 数组；只用于受控本地开发
# BCA_HUMMINGBOT_URL=
# BCA_HUMMINGBOT_AUTH= # 完整 Authorization 值，例如 Basic ...
# BCA_CCXT_PROXY= # 可选 HTTP(S) 代理，复用 CCXT httpsProxy 配置
# BCA_BRIAN_API_KEY=
# BCA_BRIAN_URL=https://api.brianknows.org
# BCA_BANKR_API_KEY=
# BCA_BANKR_URL=https://api.bankr.bot
# BCA_HEURIST_API_KEY=
# BCA_MESH_URL=https://mesh.heurist.xyz

# 原生来源工具需另行安装，provenance_status 检查 PATH。
# BCA_RISC0_VERIFIER= # 从官方部署表选择，使用上方 EVM RPC/chain ID
# BCA_OPENLINEAGE_URL=
# BCA_OPENLINEAGE_TOKEN=

# 官方开发工具和 Skills。
# BCA_SOLC_PATH=/absolute/path/to/solc
# BCA_SKILLS_ROOT=.agents/skills

# 按 examples/services 对应配置填写，不将密钥写进仓库。
# BCA_DUNE_API_KEY=
# BCA_NANSEN_API_KEY=
# BCA_ALLIUM_API_KEY=
# BCA_CHAINSTACK_API_KEY=
# BCA_THIRDWEB_SECRET_KEY=
# BCA_GOPLUS_API_KEY=
# BCA_GOPLUS_API_SECRET=

# v1.1 新增（都是只读工具，缺凭据时对应工具会直接报缺哪个变量）
# Etherscan v2：合约 ABI 查询，免费额度即可，一把 key 覆盖多链
# BCA_ETHERSCAN_API_KEY=
# ERC-4337 bundler（Pimlico / Alchemy 等）：EntryPoint 与 UserOperation 回执
# BCA_BUNDLER_URL=https://api.pimlico.io/v2/1/rpc?apikey=...
# Tenderly 交易模拟：三个变量必须同时设置
# BCA_TENDERLY_ACCOUNT=
# BCA_TENDERLY_PROJECT=
# BCA_TENDERLY_ACCESS_KEY=

# 受代理限制的 Node 24 环境可显式启用标准环境代理。
# NODE_USE_ENV_PROXY=1

# setup 自动准备的官方组件目录；源码开发时留空以复用本包 devDependencies/PATH
# BCA_COMPONENTS_DIR=/absolute/project/.bca/components
