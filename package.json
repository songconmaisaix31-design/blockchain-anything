{
  "name": "blockchain-anything",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "面向 AI Agent、基于 MCP 协议的链上能力网关",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/songconmaisaix31-design/blockchain-anything.git"
  },
  "engines": {
    "node": ">=22.12.0 <23 || >=24.0.0 <25"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./mcp": {
      "types": "./dist/mcp/main.d.ts",
      "import": "./dist/mcp/main.js"
    }
  },
  "bin": {
    "bca": "dist/cli/main.js"
  },
  "files": [
    "dist",
    "scripts/prepare.mjs",
    "docs/guides",
    "docs/integrations",
    "examples/contracts/foundry.toml",
    "examples/contracts/src/*.sol",
    "examples/contracts/test/*.sol",
    "examples/services/*.json",
    "examples/agents/*.mjs",
    "examples/agents/*.py",
    "examples/agents/package*.json",
    "examples/agents/requirements.txt",
    ".env.example"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "smoke": "node --import tsx scripts/smoke.ts",
    "check:bridge": "node --import tsx scripts/check-bridge.ts",
    "check:s2": "node --import tsx scripts/check-s2.ts",
    "check:next": "node --import tsx scripts/check-next.ts",
    "check:sessions": "node --import tsx scripts/check-sessions.ts",
    "check:setup": "node --import tsx scripts/check-setup.ts",
    "check:handoff": "node --import tsx scripts/check-handoff.ts",
    "check:v1": "node --import tsx scripts/check-v1.ts",
    "check:discovery": "node --import tsx scripts/check-discovery.ts",
    "check:workstations": "node --import tsx scripts/check-workstations.ts",
    "check:goplus": "node --import tsx scripts/check-goplus.ts",
    "prepare": "node scripts/prepare.mjs"
  },
  "dependencies": {
    "@aptos-labs/ts-sdk": "7.5.0",
    "@brian-ai/sdk": "0.3.7",
    "@cheqd/sdk": "5.5.1",
    "@ethereum-attestation-service/eas-sdk": "2.10.0",
    "@ethsign/sp-sdk": "1.2.7",
    "@modelcontextprotocol/client": "2.3.1",
    "@modelcontextprotocol/server": "2.3.1",
    "@mysten/seal": "1.5.1",
    "@mysten/sui": "2.37.0",
    "@openzeppelin/contracts": "5.6.1",
    "@safe-global/protocol-kit": "8.0.10",
    "@solana/kit": "5.5.1",
    "@virtuals-protocol/game": "0.1.14",
    "@x402/core": "2.28.0",
    "arweave": "2.1.0",
    "ccxt": "4.5.90",
    "did-jwt-vc": "5.0.1",
    "did-resolver": "6.0.0",
    "ethers": "6.17.0",
    "incur": "0.7.1",
    "key-did-resolver": "4.0.0",
    "kubo-rpc-client": "7.1.0",
    "multiformats": "14.0.5",
    "sas-lib": "1.0.10",
    "smol-toml": "1.9.1",
    "solc": "0.8.35",
    "viem": "2.57.10",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@openzeppelin/contracts-mcp": "0.8.0",
    "@types/node": "24.19.2",
    "did-jwt": "8.0.18",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  },
  "overrides": {
    "protobufjs": "7.6.3",
    "ccxt": {
      "undici": "7.30.1"
    }
  }
}
